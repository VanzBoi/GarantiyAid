NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/garantiy_aid
AUTH_PEPPER=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# SIMULATED saves a demo capture only; it never verifies identity or liveness.
FACE_PROCESSOR_MODE=SIMULATED
# REMOTE requires a validated matcher + anti-spoof service implementing docs/automatic-face.md.
# FACE_PROCESSOR_URL=https://your-private-face-service
# FACE_PROCESSOR_SECRET=private-server-to-server-key
# FACE_PROCESSOR_VERSION=your-validated-model-version
# Optional private upload directory; relative paths are resolved from backend/.
# DOCUMENT_STORAGE_DIR=storage/documents
