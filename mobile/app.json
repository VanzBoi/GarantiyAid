{
  "expo": {
    "name": "GarantiyAid",
    "slug": "garantiyaid-mobile",
    "scheme": "garantiyaid",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0ab6261d-f8c9-40ae-9628-edea90aed411"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "ph.garantiyaid.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1652C5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GarantiyAid to capture your face after you give consent.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#155596",
          "defaultChannel": "account-updates"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ab6261d-f8c9-40ae-9628-edea90aed411"
      }
    },
    "owner": "vanz3"
  }
}
